flowchart TB
    Viewer["Viewer's browser\nfollows a short link · no account · no cookie"]
    Creator["Creator's browser\nthe one embedded page · holds the management secret"]

    subgraph AWS["AWS · eu-west-2 · always-free tier"]
        subgraph Edge["CloudFront · one distribution · standard logging v2"]
            Distribution["CloudFront distribution\ndefault origin is a function · no default root object"]
            Segment["shorten-segment\nviewer request · default behaviour · overwrites the querystring with s={segment}"]
            Router["aws-cloud-router\nviewer request · /api* · strips the /api prefix"]
        end
        subgraph Functions["Lambda · Rust · arm64 · provided.al2023"]
            Redirect["shorten-redirect\ndefault origin · 302 with max-age=300 · GET / serves the embedded page"]
            Mgmt["shorten-mgmt\nbehind /api* · create, read, edit, delete · stats window"]
            Rollup["shorten-rollup\n02:15 UTC · one Athena query per day · idempotent and replayable"]
        end
        Events["EventBridge rule\ncron(15 2 * * ? *) · a date in the payload replays a night"]
        Table["DynamoDB aws-cloud table\nshared · shorten# key prefix · 25 provisioned units · TTL on ttl"]
        LogsBucket["S3 aws-cloud-logs\ngzip W3C · year/month/day · 90-day lifecycle"]
        Athena["Athena and Glue\ncloudfront_logs · partition projection · 1 GB scan cap"]
        Logs["CloudWatch Logs + Metrics\nJSON logs of all three functions · no IP, no URL"]
        Alerts["SNS aws-cloud-alerts\n3 alarms, all billed · email subscription"]
    end

    Viewer -->|"GET /{code}"| Distribution
    Creator -->|"GET / and /api/*"| Distribution
    Distribution -->|"viewer request"| Segment
    Distribution -->|"viewer request"| Router
    Segment -->|"cache miss on path + s"| Redirect
    Router -->|"/links, /links/{code}"| Mgmt
    Redirect -->|"GetItem shorten#L#{code}"| Table
    Mgmt -->|"link rows, rate limit, BatchGetItem stats"| Table
    Distribution -->|"standard logs v2"| LogsBucket
    LogsBucket -->|"external table"| Athena
    Athena -->|"code, segment, count where sc_status=302"| Rollup
    Events -->|"cron(15 2 * * ? *)"| Rollup
    Rollup -->|"paced writes: stats day, clicks_total"| Table
    Logs -->|"3 alarms"| Alerts

